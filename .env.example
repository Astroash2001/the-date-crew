# The Date Crew: Pre-Send Profile Gate Configuration
# Copy this file to .env and insert your Experiential Labs API credentials.
# Do NOT commit .env to source control.

# Experiential Labs API Key
EXPERIENTIAL_API_KEY=your_experiential_labs_key_here

# Experiential Labs Base URL (OpenAI-compatible)
EXPERIENTIAL_BASE_URL=https://api.experientiallabs.ai/v1

# AI Model Slug provisioned on your gateway (e.g., gpt-4o-mini, claude-3-5-sonnet, etc.)
EXPERIENTIAL_MODEL=gpt-4o-mini

# Server Port
PORT=3000
